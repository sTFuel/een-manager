# Required: API key for authentication
API_KEY=your-secure-api-key-here

# Optional: Server port (default: 3000)
PORT=3000

# Optional: Base directory for node data (default: /mnt/edgenodes)
DATA_DIR=/mnt/edgenodes

# Optional: Starting port for nodes (default: 17888)
BASE_PORT=17888

# Optional: Docker image (default: thetalabsorg/edgelauncher_mainnet:v1.0.0, testnet: pizajolo/edgecore-testnet:latest)
DOCKER_IMAGE=thetalabsorg/edgelauncher_mainnet:v1.0.0

# Password for Keystore files
PASSWORD=KEYSTORE_PASSWORD

# Network: either testnet or mainnet
NETWORK=testnet

# Theta RPC for checking wallet balance
THETA_RPC_URL=https://eth-rpc-api-testnet.thetatoken.org/rpc

# Theta Chain ID for Theta-JS
THETA_CHAIN_ID=365