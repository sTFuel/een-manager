# Required: API key for authentication
API_KEY=your-secure-api-key-here

# Optional: Server port (default: 3000)
PORT=3000

# Optional: Base directory for node data (default: /mnt/edgenodes)
DATA_DIR=/mnt/edgenodes

# Optional: Starting port for nodes (default: 17888)
BASE_PORT=17888

# Optional: Docker image (default: thetalabsorg/edgelauncher_mainnet:v1.0.0)
DOCKER_IMAGE=thetalabsorg/edgelauncher_mainnet:v1.0.0
